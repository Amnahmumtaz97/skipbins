
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_TEST_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public site URL used for sitemap, canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.skippybinhire.com.au
ADMIN_EMAILS=owner@example.com
# Supplier users use Supabase app_metadata.role=supplier and are linked to public.suppliers.auth_user_id.
GET_ADDRESS_API_KEY=your-getaddress-api-key
# Resend transactional email (booking confirmation + supplier/office alerts after Stripe payment)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SkippyBinHire <bookings@skippybinhire.com.au>
RESEND_REPLY_TO_EMAIL=info@skippybinhire.com.au
# Office inbox for new paid-order alerts (ADMIN_EMAILS also get the same alert)
BOOKING_NOTIFY_EMAIL=info@skippybinhire.com.au
# Optional: local/test recipient override for manual Resend dashboard tests
RESEND_TEST_TO_EMAIL=
# Road km defaults to public OSRM (no signup).
# Optional override for self-hosted OSRM (default: https://router.project-osrm.org)
OSRM_BASE_URL=
# Optional later: ROAD_DISTANCE_PROVIDER=openrouteservice + OPENROUTESERVICE_API_KEY=...
OPENROUTESERVICE_API_KEY=
ROAD_DISTANCE_PROVIDER=
